# ShopNest environment configuration
# Copy this file to .env and change every value before deploying.
# NEVER commit the real .env file.

# --- Database (PostgreSQL) ---
POSTGRES_DB=shopnest
POSTGRES_USER=shopnest
POSTGRES_PASSWORD=change-me-to-a-strong-password

# --- Runtime ---
ASPNETCORE_ENVIRONMENT=Production
APP_VERSION=local
APP_COMMIT=unknown

# --- Public entry point ---
# Host port published by the Nginx gateway (EC2 security group must allow 80/443).
GATEWAY_PORT=80
PUBLIC_URL=http://localhost

# --- Container images ---
# Leave BACKEND_IMAGE / FRONTEND_IMAGE empty to use the local build tags.
# CI/CD overrides these with the immutable SHA-tagged images from GHCR.
REGISTRY=ghcr.io/arifuzzaman-hredoy
IMAGE_TAG=latest
BACKEND_IMAGE=
FRONTEND_IMAGE=

# --- Blue-Green ---
# Set to false when images are built locally and must not be pulled from a registry.
PULL_IMAGES=true